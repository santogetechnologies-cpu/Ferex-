# Browser (Vite) settings. Only public values belong here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay is called from Supabase Edge Functions, so its keys are Edge Function secrets, not browser variables.
# Set them in Supabase Dashboard > Edge Functions > Secrets (never commit them):
#   RAZORPAY_KEY_ID       rzp_test_... (public key id; the order function returns it to the checkout window)
#   RAZORPAY_KEY_SECRET   the key secret. Server only.
#   RAZORPAY_WEBHOOK_SECRET  optional: lets the existing verify-payment webhook settle payments if the browser closes early
