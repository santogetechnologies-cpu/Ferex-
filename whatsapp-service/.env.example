# ---- Required to SEND ----
# Permanent System User token (Meta Business Settings -> System users). Never commit it, never log it.
WA_TOKEN=
WA_PHONE_NUMBER_ID=1387273184478526
WA_WABA_ID=4083659841942268

# ---- Required for the WEBHOOK ----
# App Dashboard -> App settings -> Basic -> App secret (used to verify X-Hub-Signature-256)
WA_APP_SECRET=
# Any long random text you invent; paste the same text into Meta's "Verify token" box
WA_VERIFY_TOKEN=

# ---- Optional ----
PORT=3000
WA_GRAPH_VERSION=v21.0
# Added to 10-digit numbers that have no country code
WA_DEFAULT_COUNTRY_CODE=91
# Bulk pacing: messages per second (hard cap 10)
WA_RATE_PER_SECOND=5
# Business verification is not complete: Meta allows ~250 unique business-initiated recipients per rolling 24 h
WA_DAILY_UNIQUE_LIMIT=250
# If set, every customer text message gets this free-text reply (valid inside the 24 h window)
WA_AUTO_REPLY_TEXT=
DB_PATH=./data/whatsapp.sqlite
